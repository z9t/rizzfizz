javascript:(function(){ /* GrabGallery — extract all external URLs from gallery cards on the current page. Finds containers matching a common gallery pattern (div/a with external links), deduplicates, copies to clipboard. Click bookmarklet on any gallery page. */ const BASE = location.hostname.replace(/^www\./,''); const seen = new Set(); const links = []; /* Strategy: find gallery cards by looking for <a> tags inside container divs where the link goes to an external site and the container looks like a card. */ const allAs = document.querySelectorAll('a[href^=http]'); for (const a of allAs) { const href = a.href; if (href.includes(BASE)) continue; // skip internal links if (href.includes('twitter.com') || href.includes('x.com') || href.includes('facebook.com') || href.includes('instagram.com') || href.includes('github.com') || href.includes('youtube.com') || href.includes('cloudflare.com') || href.includes('wp-') || href.match(/\.(png|jpg|jpeg|gif|svg|webp|ico|css|js|woff2?)(\?|$)/)) continue; // Clean tracking params let clean = href.replace(/[?&]ref=.*$/,'').replace(/[?&]utm_.*$/,'').replace(/[?&]source=.*$/,'').replace(/[?&]fbclid=.*$/,''); if (!seen.has(clean)) { seen.add(clean); links.push(clean); } } const text = links.join('\n'); if (links.length === 0) { alert('GrabGallery: no external links found on this page.\n\nTry a gallery page like land-book.com or minimal.gallery.'); return; } navigator.clipboard.writeText(text).then(() => { showToast(links.length + ' links copied to clipboard'); }).catch(() => { // Fallback: show in textarea const ta = document.createElement('textarea'); ta.value = text; ta.style.cssText = 'position:fixed;top:10px;right:10px;width:400px;height:300px;z-index:99999;font:12px monospace;background:#111;color:#0f0;border:1px solid #333;padding:10px;'; ta.onclick = () => ta.remove(); document.body.appendChild(ta); ta.select(); }); function showToast(msg) { const t = document.createElement('div'); t.textContent = msg; t.style.cssText = 'position:fixed;bottom:20px;right:20px;background:#111;color:#0f0;padding:10px 20px;border-radius:6px;z-index:99999;font:14px system-ui;border:1px solid #333;'; document.body.appendChild(t); setTimeout(() => { t.style.opacity='0'; t.style.transition='opacity 0.3s'; setTimeout(()=>t.remove(),300); }, 2000); }})();